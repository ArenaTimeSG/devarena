# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Mercado Pago (Global - para compatibilidade)
MP_ACCESS_TOKEN=your_mercadopago_access_token_here

# Supabase (OBRIGATÓRIAS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# URLs (para produção)
WEBHOOK_URL=https://your-app.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# CORS - Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# Encryption Key (para criptografar chaves dos admins)
# Gerar uma chave de 32 caracteres: openssl rand -hex 32
ENCRYPTION_KEY=your_32_character_encryption_key_here

# JWT Configuration (OBRIGATÓRIO para produção)
# Gerar uma chave segura: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
