# ============================================
# VARIÁVEIS DE AMBIENTE - FRONTEND
# ============================================
# 
# ⚠️ IMPORTANTE: Estas variáveis são OBRIGATÓRIAS
# 
# Para desenvolvimento local:
# 1. Copie este arquivo para .env
# 2. Preencha os valores abaixo
#
# Para produção (Vercel):
# 1. Configure no painel do Vercel: Settings > Environment Variables
# 2. Adicione cada variável marcando: Production, Preview, Development
# 3. Faça um redeploy após adicionar
#
# ============================================

# Configuração do Supabase (OBRIGATÓRIAS)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Chave pública do Mercado Pago (Opcional)
VITE_MP_PUBLIC_KEY=sua_chave_publica_mercado_pago


